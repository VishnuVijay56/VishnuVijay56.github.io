---
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import { siteSettings } from '../data/site';
import { withBase } from '../lib/paths';
const { project, index = 0 } = Astro.props as { project: CollectionEntry<'projects'>; index?: number };
const showMedia = siteSettings.showResearchFigures && Boolean(project.data.hero);
---
<article class:list={['project-card', { 'project-card--text-only': !showMedia }]}>
  {showMedia && project.data.hero && <div class="project-card__media"><ProjectMedia media={project.data.hero} eager={index === 0} previewOnly /></div>}
  <div class="project-card__body">
    <p class="eyebrow">Research project <span>{String(index + 1).padStart(2, '0')}</span></p>
    <h3>{siteSettings.showResearchDetails ? <a href={withBase(`/research/${project.id}/`)}>{project.data.title}</a> : project.data.title}</h3>
    <p class="project-card__summary">{project.data.summary}</p>
    {project.data.tags.length > 0 && <ul class="tag-list" aria-label="Research topics">{project.data.tags.map(tag => <li>{tag}</li>)}</ul>}
    {siteSettings.showResearchDetails && <a class="text-link" href={withBase(`/research/${project.id}/`)} aria-label={`Read about ${project.data.title}`}>Explore project <span aria-hidden="true">↗</span></a>}
  </div>
</article>
