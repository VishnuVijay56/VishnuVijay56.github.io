---
import type { Publication } from '../data/publications';
import { personal } from '../data/personal';
const { publication, compact = false } = Astro.props as { publication: Publication; compact?: boolean };
const volumeIssue = publication.volume ? `${publication.volume}${publication.issue ? `(${publication.issue})` : ''}` : '';
const citationDetails = [volumeIssue, publication.pages && `pp. ${publication.pages}`, publication.note].filter(Boolean).join(' · ');
const abstractParagraphs = publication.abstract?.trim().split(/\r?\n\s*\r?\n/).map(paragraph => paragraph.trim()).filter(Boolean) ?? [];
const links = publication.category === 'Manuscripts' ? [] : [
  { label: publication.doi ? 'DOI' : 'Paper', href: publication.doi ? (publication.doi.startsWith('http') ? publication.doi : `https://doi.org/${publication.doi}`) : (publication.paper || publication.pdf) },
  { label: 'Code', href: publication.code },
  { label: 'Video', href: publication.video },
].filter(link => link.href);
---
<article class="publication-entry" id={publication.id}>
  <div class="publication-entry__year">{publication.year || (publication.placeholder ? 'Example' : '—')}</div>
  <div>
    <p class="publication-authors">{publication.authors.map((author, index) => <>{index > 0 && ', '}{author === personal.name ? <strong>{author}</strong> : author}</>)}</p>
    <h3>{publication.title}</h3>
    <p class="publication-venue">{publication.venue}{citationDetails && ` · ${citationDetails}`}{publication.year && ` · ${publication.year}`}</p>
    {!compact && publication.description && <p class="publication-description">{publication.description}</p>}
    {links.length > 0 && <div class="publication-links">{links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
    {!compact && abstractParagraphs.length > 0 && <details class="publication-abstract"><summary>Read abstract</summary>{abstractParagraphs.map(paragraph => <p>{paragraph}</p>)}</details>}
    {publication.placeholder && <p class="placeholder-note">Placeholder citation — add verified details and links in publications.ts.</p>}
  </div>
</article>
