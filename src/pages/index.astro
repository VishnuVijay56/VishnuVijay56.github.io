---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { personal } from '../data/personal';
import { publications } from '../data/publications';
import { externalLinks } from '../data/links';
import { siteSettings } from '../data/site';
import { withBase } from '../lib/paths';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Purdue University · Aeronautics & Astronautics</p>
      <h1 id="hero-title">{personal.name}</h1>
      <p class="hero-role">{personal.role}<br />{personal.institution}</p>
      <p class="hero-areas">{personal.researchAreas.join(' · ')}</p>
      <p class="hero-bio">{personal.bio}</p>
      <div class="hero-actions">{siteSettings.showResearchDetails && <a class="button button-primary" href={withBase('/research/')}>Explore research <span aria-hidden="true">↗</span></a>}<a class:list={['button', siteSettings.showResearchDetails ? 'button-quiet' : 'button-primary']} href={withBase('/files/cv.pdf')}>Download CV <span aria-hidden="true">↓</span></a></div>
    </div>
        <figure class="portrait"><img src={withBase(personal.headshot)} alt={personal.headshotAlt} width="560" height="640" /></figure>
  </section>

  <section class="section selected-research" aria-labelledby="research-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">01 / Work</p><h2 id="research-title">Selected Research</h2><p class="section-intro">Projects in safe autonomy and resilient control.</p></div>{siteSettings.showResearchDetails && <a class="text-link" href={withBase('/research/')}>All research <span aria-hidden="true">↗</span></a>}</div>
      <div class="projects-stack">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    </div>
  </section>

  <section class="section publications-preview" aria-labelledby="publications-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">02 / Writing</p><h2 id="publications-title">Selected Publications</h2><p class="section-intro">Recent work in resilient autonomy, distributed optimization, and multi-robot systems.</p></div><a class="text-link" href={withBase('/publications/')}>View all publications <span aria-hidden="true">↗</span></a></div>
      <div class="publication-list">{publications.slice(0, 3).map(publication => <PublicationEntry publication={publication} compact />)}</div>
    </div>
  </section>

  <section class="contact-section" aria-labelledby="contact-title"><div class="container contact-inner"><div><p class="eyebrow">03 / Connect</p><h2 id="contact-title">Get in touch</h2><p>For research discussions, collaborations, and opportunities.</p></div><div class="contact-links">{externalLinks.filter(link => link.available).map(link => <a class="text-link" href={link.href} target={link.label === 'Email' ? undefined : '_blank'} rel={link.label === 'Email' ? undefined : 'noopener noreferrer'}>{link.label} <span aria-hidden="true">↗</span></a>)}</div></div></section>
</BaseLayout>
