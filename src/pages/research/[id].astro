---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import PublicationEntry from '../../components/PublicationEntry.astro';
import { publications } from '../../data/publications';
import { siteSettings } from '../../data/site';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);
const related = publications.filter(publication => project.data.relatedPublications.includes(publication.id));
const links = [
  { label: 'Paper', href: project.data.links?.paper },
  { label: 'Code', href: project.data.links?.code },
  { label: 'Video', href: project.data.links?.video },
].filter(link => link.href);
---
<BaseLayout title={project.data.title} description={project.data.summary} noindex={!siteSettings.showResearchDetails}>
  <article class="project-detail container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBase('/research/')}>Research</a><span aria-hidden="true">/</span><span>{project.data.title}</span></nav>
    <header class="project-detail__header"><p class="eyebrow">Research project{project.data.placeholder && ' · Example entry'}</p><h1>{project.data.title}</h1><p class="project-detail__summary">{project.data.summary}</p>{project.data.tags.length > 0 && <ul class="tag-list" aria-label="Research topics">{project.data.tags.map(tag => <li>{tag}</li>)}</ul>}</header>
    {siteSettings.showResearchFigures && project.data.hero && <div class="project-detail__hero"><ProjectMedia media={project.data.hero} eager /></div>}
    <div class="project-detail__grid">
      <div class="prose"><Content />{related.length > 0 && <section class="detail-section" aria-labelledby="related-title"><h2 id="related-title">Related Publications</h2><div class="publication-list">{related.map(publication => <PublicationEntry publication={publication} compact />)}</div></section>}{links.length > 0 && <section class="detail-section" aria-labelledby="links-title"><h2 id="links-title">Links</h2><div class="detail-links">{links.map(link => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div></section>}</div>
      <aside class="project-aside"><p class="eyebrow">Topics</p><ul>{project.data.tags.map(tag => <li>{tag}</li>)}</ul><a class="text-link" href={withBase('/research/')}>← All research</a></aside>
    </div>
  </article>
</BaseLayout>
